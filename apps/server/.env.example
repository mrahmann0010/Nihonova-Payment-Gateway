# --- Backend (Express API) environment variables ---
#
# Copy to .env. The defaults below are the LOCAL development setup: they point
# at the Docker MongoDB in docker-compose.yml at the repo root, so a fresh clone
# runs against a disposable database rather than the live cluster.
#
#   docker compose up -d     (repo root) start the database
#   npm run db:copy          fill it with a copy of the real Atlas data
#   npm run seed-admin       create a local dashboard login
#   npm run dev              start the API
#
# Real production values belong in .env.atlas (see .env.atlas.example), which is
# gitignored and which nothing loads automatically.

# Port the server listens on. Defaults to 3000 if unset. Keep in step with
# PUBLIC_API_BASE_URL in apps/web/.env.
PORT=3001

# MongoDB connection string. REQUIRED — the server exits on startup if unset.
# The local Docker database, using the same database name as production so an
# index or query that works here works there.
MONGO_URI=mongodb://127.0.0.1:27017/primary-data

# Leave as 'development' locally: 'production' makes the session cookie Secure,
# and a Secure cookie is dropped over plain http://localhost, which presents as
# a login that silently never sticks.
NODE_ENV=development

# Secret token for authenticating the Android SMS Gateway app.
# Set to a random string and append ?token=<value> to the webhook URL in the app.
# Example app URL: https://yourserver.com/webhooks/sms?token=abc123xyz
WEBHOOK_SECRET=local-webhook-token

# Secret token for the admin dashboard/API. In production this MUST be set or the
# admin API returns 503. In development, an unset token disables the gate.
ADMIN_TOKEN=local-admin-token

# Sender IDs/numbers to accept per platform (case-insensitive). SMS from any
# sender not matching one of these is ignored. If all three are unset, every
# sender is accepted.
BKASH_SENDER=bKash
NAGAD_SENDER=NAGAD
ROCKET_SENDER=16216

# Comma-separated allowlist of origins permitted to call the JSON API (the
# SvelteKit frontend runs on a different origin). Defaults to * if unset.
# NOTE: cookie auth needs credentialed CORS, which forbids a wildcard — list the
# exact frontend origin(s). The SvelteKit dev server is :5173.
CORS_ORIGIN=http://localhost:5173

# --- Admin dashboard auth (JWT session cookie) ---
# Secret used to sign session JWTs. REQUIRED in production: services/jwt.js
# throws for a missing secret only when NODE_ENV=production, and otherwise falls
# back to a literal that is committed in this repo. Set it in the deployment.
JWT_SECRET=local-development-jwt-secret-not-for-production

# Default admin account created by the one-time seed script:
#   npm run seed-admin
# (not run automatically on server startup)
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=localdev1234

# Set to 'json' for one log object per line instead of aligned columns.
# LOG_FORMAT=json
