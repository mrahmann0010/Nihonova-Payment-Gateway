# --- Backend (Express API) environment variables ---
# Copy this file to .env and fill in the values for your deployment.

# Port the server listens on. Defaults to 3000 if unset.
PORT=3000

# MongoDB connection string. REQUIRED — the server exits on startup if unset.
MONGO_URI=mongodb://localhost:27017/bkash-payments

# Secret token for authenticating the Android SMS Gateway app.
# Set to a random string and append ?token=<value> to the webhook URL in the app.
# Example app URL: https://yourserver.com/webhooks/sms?token=abc123xyz
WEBHOOK_SECRET=your-shared-secret-here

# Secret token for the admin dashboard/API. In production this MUST be set or the
# admin API returns 503. In development, an unset token disables the gate.
ADMIN_TOKEN=your-admin-token-here

# Sender IDs/numbers to accept per platform (case-insensitive). SMS from any
# sender not matching one of these is ignored. If all three are unset, every
# sender is accepted.
BKASH_SENDER=bKash
NAGAD_SENDER=NAGAD
ROCKET_SENDER=Rocket

# Comma-separated allowlist of origins permitted to call the JSON API (the
# SvelteKit frontend runs on a different origin). Use * to allow any origin.
# Defaults to * if unset. NOTE: cookie auth needs the browser to send
# credentials, so list the exact frontend origin(s) here in production rather
# than '*'.
CORS_ORIGIN=*

# --- Admin dashboard auth (JWT session cookie) ---
# Secret used to sign session JWTs. REQUIRED in production (server throws if
# unset/left as change-me). Use a long random string.
JWT_SECRET=change-me

# Default admin account created by the one-time seed script:
#   npm run seed-admin
# (not run automatically on server startup)
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=2250
