# --- Template for .env.atlas: the REAL production credentials ---
#
# Copy to .env.atlas and fill in from the Atlas dashboard and the deployment's
# environment settings. `.env.atlas` is gitignored; this template is not, so it
# must never contain a real value.
#
# Nothing loads .env.atlas automatically — `dotenv` reads `.env` and only `.env`.
# It exists so `npm run db:copy` can read MONGO_URI to pull a copy of the live
# data into the local Docker database, and so the live values have one home
# instead of living in a password manager note and three shell histories.
#
# Only MONGO_URI is required for db:copy. The rest are here so the file is a
# complete record of what the deployment is configured with.

# Atlas connection string, including the database name.
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?appName=<app>
MONGO_URI=

# The token in the Android forwarder's webhook URL: /webhooks/sms?token=<value>
WEBHOOK_SECRET=

# Legacy shared admin token.
ADMIN_TOKEN=

# Signs admin session cookies. Must be set in the deployment — see the note in
# .env.example about the fallback.
JWT_SECRET=

# Exact dashboard origin(s), comma separated. Not '*': credentialed CORS
# forbids a wildcard.
CORS_ORIGIN=

BKASH_SENDER=bKash
NAGAD_SENDER=NAGAD
ROCKET_SENDER=16216
