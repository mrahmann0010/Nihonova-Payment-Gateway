PORT=3000
MONGO_URI=mongodb://localhost:27017/bkash-payments

# Secret token for authenticating the Android SMS Gateway app.
# Set this to a random string and append ?token=<value> to the webhook URL in the app.
# Example app URL: https://yourserver.com/webhooks/sms?token=abc123xyz
WEBHOOK_SECRET=your-shared-secret-here

# Secret token for the admin dashboard at /admin (view-only payment records +
# analytics). Set to a random string. In production this MUST be set or the
# admin API returns 503. In development, an unset token disables the gate.
ADMIN_TOKEN=your-admin-token-here

# Comma-separated list of sender IDs/numbers to accept (case-insensitive).
# Use * to accept SMS from every sender.
# Examples:
#   ALLOWED_SENDERS=*
#   ALLOWED_SENDERS=bKash,16247,01522112743
ALLOWED_SENDERS=*
