{
  "name": "@sakura/pay",
  "version": "0.1.0",
  "description": "Server-side client for the Nihonova payment gateway: claim bKash / Nagad / Rocket payments exactly once.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18.17"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./testing": {
      "import": { "types": "./dist/testing.d.ts", "default": "./dist/testing.js" },
      "require": { "types": "./dist/testing.d.cts", "default": "./dist/testing.cjs" }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "testing": ["./dist/testing.d.cts"]
    }
  },
  "files": [
    "dist",
    "README.md",
    "DESIGN.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "release": "npm run check && npm pack",
    "prepare": "tsup"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsup": "^8.5.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  }
}
