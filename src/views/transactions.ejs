<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Admin · Transactions', css: '/css/admin.css', noindex: true }) %>
</head>
<body>

<%- include('partials/header', { subtitle: 'admin', headerRight: '<a class="tag" href="/">&larr; Home</a>' }) %>

<main class="wrap">

  <%- include('partials/gate') %>

  <section class="app" x-data="{ platform: 'all' }" x-show="$store.auth.authed" x-cloak>
    <div class="page-head">
      <div>
        <h1>Transactions</h1>
        <div class="sub">Filter, search, and page through every record.</div>
      </div>
      <div class="head-actions">
        <a class="btn ghost" href="/admin">&lsaquo; Dashboard</a>
        <button class="btn ghost" @click="$store.auth.logout()">Sign out</button>
      </div>
    </div>

    <form class="toolbar" x-ref="filters"
          hx-get="/admin/partials/transactions"
          hx-target="#table-wrap" hx-swap="innerHTML"
          hx-trigger="auth-ready from:body, submit, keyup changed delay:400ms from:input[name=search]"
          @submit.prevent>
      <input type="hidden" name="platform" :value="platform" />
      <input type="hidden" name="limit" value="20" />
      <div class="seg">
        <% ['all','bkash','nagad','rocket'].forEach(function (p) { %>
          <button type="button" :class="{ active: platform === '<%= p %>' }"
                  @click="platform = '<%= p %>'; $refs.filters.requestSubmit()"><%= p === 'all' ? 'All' : (p === 'bkash' ? 'bKash' : p[0].toUpperCase() + p.slice(1)) %></button>
        <% }); %>
      </div>
      <div class="search"><input type="text" name="search" placeholder="Search trxId or sender…" /></div>
    </form>

    <div class="table-wrap" id="table-wrap">
      <div class="loading">Loading…</div>
    </div>
  </section>

</main>

<%- include('partials/scripts', { withChartJs: false }) %>

</body>
</html>
