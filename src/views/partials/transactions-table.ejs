<%# Transactions table shell (initial/filtered load). Rendered for htmx swaps
    into #table-wrap. Row markup + the infinite-scroll sentinel live in
    partials/transactions-rows so continuation requests can reuse them. %>
<div class="info-row">
  <span class="info"><%= total.toLocaleString() %> record<%= total === 1 ? '' : 's' %></span>
</div>
<div class="table-scroll">
  <table>
    <thead>
      <tr>
        <th>Platform</th><th>TrxID</th><th>Amount</th><th>Sender</th>
        <th>Fee</th><th>Balance</th><th>Ref</th><th>Date &middot; time</th><th>SIM</th>
      </tr>
    </thead>
    <tbody>
      <%- include('transactions-rows', { payments, page, pages, platform, search, limit, h }) %>
    </tbody>
  </table>
</div>
