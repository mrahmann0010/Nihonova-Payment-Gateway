<%# One page of transaction rows, plus a scroll sentinel that lazy-loads the
    next page. Rendered both inline (inside transactions-table.ejs's <tbody>)
    and standalone (htmx swaps this in to replace the sentinel it came from). %>
<% if (!payments.length) { %>
  <tr><td colspan="9" class="empty">No payments found.</td></tr>
<% } else { payments.forEach(function (p) { %>
  <tr>
    <td><span class="pill <%= p.platform %>"><%= p.platform %></span></td>
    <td class="mono"><%= p.trxId %></td>
    <td class="amt-cell">৳ <%= h.fmtAmount(p.amount) %></td>
    <td class="mono"><%= p.sender %></td>
    <td class="mono dim"><%= h.fmtAmount(p.fee) %></td>
    <td class="mono dim"><%= h.fmtAmount(p.balance) %></td>
    <td class="mono dim"><%= p.ref || '—' %></td>
    <td class="mono dim"><%= h.fmtDateTime(p.dateReceived) %></td>
    <td class="mono dim"><%= p.simNumber != null ? p.simNumber : '—' %></td>
  </tr>
<% }); } %>
<% if (page < pages) {
  var nextUrl = '/admin/partials/transactions?platform=' + platform
    + '&search=' + encodeURIComponent(search) + '&limit=' + limit + '&page=' + (page + 1);
%>
  <tr id="scroll-sentinel"
      hx-get="<%= nextUrl %>"
      hx-trigger="revealed"
      hx-target="this" hx-swap="outerHTML">
    <td colspan="9" class="empty htmx-indicator">Loading more…</td>
  </tr>
<% } %>
