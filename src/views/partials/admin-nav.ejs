<%# Tab navigation shared by every /admin/* page. `active` picks the current tab. %>
<nav class="admin-nav">
  <div class="wrap admin-nav-inner">
    <div class="admin-nav-tabs">
      <a href="/admin"              class="<%= active === 'dashboard'    ? 'active' : '' %>">Dashboard</a>
      <a href="/admin/transactions" class="<%= active === 'transactions' ? 'active' : '' %>">Transactions</a>
      <a href="/admin/reports"      class="<%= active === 'reports'      ? 'active' : '' %>">Reports</a>
      <a href="/admin/health"       class="<%= active === 'health'       ? 'active' : '' %>">Health</a>
    </div>

    <div class="bell-wrap" x-data @click.outside="$store.alerts.open = false">
      <button class="bell-btn" :class="{ has: $store.alerts.items.length }" @click="$store.alerts.open = !$store.alerts.open">
        &#128276;
        <span class="bell-badge" x-show="$store.alerts.items.length" x-cloak x-text="$store.alerts.items.length"></span>
      </button>
      <div class="bell-dropdown" x-show="$store.alerts.open" x-cloak>
        <div class="bell-dropdown-head">Alerts</div>
        <template x-if="!$store.alerts.items.length">
          <div class="bell-empty">No issues right now.</div>
        </template>
        <template x-for="a in $store.alerts.items" :key="a.text">
          <div class="bell-item" :class="a.cls" x-text="a.text"></div>
        </template>
        <a class="bell-link" href="/admin/health">View pipeline health &rsaquo;</a>
      </div>
    </div>
  </div>
</nav>
