<%# Latest transaction highlight + the preceding rows. Rendered for htmx. %>
<% if (!payments.length) { %>
  <div class="empty">No payments yet.</div>
<% } else { var p = payments[0]; %>
  <div class="latest-card">
    <div class="latest-when">
      <span class="latest-ago"><%= h.fmtAgo(p.dateReceived) %></span>
      <span class="latest-abs"><%= h.fmtDateTime(p.dateReceived) %></span>
    </div>
    <div class="latest-main">
      <span class="pill <%= p.platform %>"><%= p.platform %></span>
      <span class="latest-amt">৳ <%= h.fmtAmount(p.amount) %></span>
    </div>
    <div class="latest-detail">
      <div><span class="k">TrxID</span><span class="v"><%= p.trxId %></span></div>
      <div><span class="k">Sender</span><span class="v"><%= p.sender %></span></div>
      <div><span class="k">Ref</span><span class="v"><%= p.ref || '—' %></span></div>
    </div>
  </div>

  <div class="recent-list" x-show="showRecent" x-cloak>
    <% var rest = payments.slice(1); %>
    <% if (!rest.length) { %>
      <div class="empty">No earlier transactions.</div>
    <% } else { rest.forEach(function (r) { %>
      <div class="recent-row">
        <span class="pill <%= r.platform %>"><%= r.platform %></span>
        <span class="r-trx"><%= r.trxId %></span>
        <span class="r-amt">৳ <%= h.fmtAmount(r.amount) %></span>
        <span class="r-time"><%= h.fmtAgo(r.dateReceived) %></span>
      </div>
    <% }); } %>
  </div>
<% } %>
