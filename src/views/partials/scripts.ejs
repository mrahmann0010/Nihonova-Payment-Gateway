<!--
  Client glue for the admin pages.
    • Alpine  — UI state: the token gate, toggles, active filter pills.
    • htmx    — server-driven partials: the recent panel + the transactions table.
  The admin token lives in sessionStorage; htmx attaches it to every request,
  and a 401 anywhere drops the session back to the gate.
-->
<script>
  (function () {
    var KEY = 'admin_token';

    // htmx: attach the admin token to every request it makes.
    document.body.addEventListener('htmx:configRequest', function (e) {
      var t = sessionStorage.getItem(KEY);
      if (t) e.detail.headers['x-admin-token'] = t;
    });
    // htmx: any 401 means the token is gone/expired — bounce to the gate.
    document.body.addEventListener('htmx:responseError', function (e) {
      if (e.detail.xhr && e.detail.xhr.status === 401) {
        sessionStorage.removeItem(KEY);
        if (window.Alpine) Alpine.store('auth').reset('Session expired — sign in again.');
      }
    });

    // Small formatter for the Alpine-rendered stat cards.
    window.fmt = {
      amount: function (n) {
        if (n == null) return '—';
        return Number(n).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      },
      count: function (n) { return (n || 0).toLocaleString(); },
    };

    document.addEventListener('alpine:init', function () {
      Alpine.store('auth', {
        token: sessionStorage.getItem(KEY) || '',
        authed: false,
        checking: false,
        error: '',
        stats: null,           // last /stats payload, reused by the dashboard charts

        init: function () {
          if (this.token) this.verify(this.token);
        },
        reset: function (msg) {
          this.authed = false;
          this.token = '';
          this.error = msg || '';
          sessionStorage.removeItem(KEY);
        },
        logout: function () { this.reset(''); location.reload(); },

        // Verify a token against /stats; on success unlock the page + cache stats.
        verify: function (t) {
          var self = this;
          self.checking = true;
          self.error = '';
          return fetch('/admin/api/stats', { headers: { 'x-admin-token': t } })
            .then(function (r) {
              if (r.status === 401) throw new Error('Invalid token');
              if (!r.ok) throw new Error('Server error (' + r.status + ')');
              return r.json();
            })
            .then(function (data) {
              self.token = t;
              self.authed = true;
              self.stats = data;
              sessionStorage.setItem(KEY, t);
              // Let htmx-powered panels load now that we're authed.
              window.dispatchEvent(new CustomEvent('stats-loaded', { detail: data }));
              document.body.dispatchEvent(new CustomEvent('auth-ready'));
            })
            .catch(function (err) { self.error = err.message; })
            .finally(function () { self.checking = false; });
        },

        // Re-pull stats (dashboard "Refresh").
        refresh: function () {
          var self = this;
          return fetch('/admin/api/stats', { headers: { 'x-admin-token': self.token } })
            .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
            .then(function (data) {
              self.stats = data;
              window.dispatchEvent(new CustomEvent('stats-loaded', { detail: data }));
            })
            .catch(function () {});
        },
      });
    });
  })();
</script>
<script src="https://unpkg.com/htmx.org@2.0.4" defer></script>
<script src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js" defer></script>
<% if (typeof withChartJs !== 'undefined' && withChartJs) { %>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js" defer></script>
<% } %>
