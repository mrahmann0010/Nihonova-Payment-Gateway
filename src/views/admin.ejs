<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Admin · Dashboard', css: '/css/admin.css', noindex: true }) %>
</head>
<body>

<%- include('partials/header', { subtitle: 'admin', headerRight: '<a class="tag" href="/">&larr; Home</a>' }) %>

<main class="wrap">

  <%- include('partials/gate') %>

  <section class="app" x-data="dashboard" x-show="$store.auth.authed" x-cloak>
    <div class="page-head">
      <div>
        <h1>Dashboard</h1>
        <div class="sub" x-text="updated">&mdash;</div>
      </div>
      <div class="head-actions">
        <button class="btn ghost" @click="$store.auth.refresh(); $dispatch('refresh-recent')">Refresh</button>
        <button class="btn ghost" @click="$store.auth.logout()">Sign out</button>
      </div>
    </div>

    <div class="stats">
      <template x-for="c in cards()" :key="c.label">
        <div class="stat" :class="c.cls">
          <div class="lbl">
            <template x-if="c.cls"><span class="dot" :class="c.cls"></span></template>
            <span x-text="c.label"></span>
          </div>
          <div class="num" x-text="window.fmt.count(c.count)"></div>
          <div class="amt" x-text="'৳ ' + window.fmt.amount(c.amount)"></div>
        </div>
      </template>
    </div>

    <div class="charts">
      <div class="panel">
        <h3>Payments per day &middot; last 14 days</h3>
        <div class="canvas-box"><canvas x-ref="trend"></canvas></div>
      </div>
      <div class="panel">
        <h3>Share by platform</h3>
        <div class="canvas-box"><canvas x-ref="share"></canvas></div>
      </div>
    </div>

    <div class="panel" style="margin-bottom:26px;">
      <div class="panel-head">
        <h3>Revenue per day &middot; last 14 days</h3>
        <span class="sub" x-text="revTotal">&mdash;</span>
      </div>
      <div class="canvas-box"><canvas x-ref="revenue"></canvas></div>
    </div>

    <div class="panel" x-data="{ showRecent: false }">
      <div class="panel-head">
        <h3>Latest transaction</h3>
        <a class="btn ghost" href="/admin/transactions">See all &rsaquo;</a>
      </div>

      <div hx-get="/admin/partials/recent"
           hx-trigger="auth-ready from:body, refresh-recent from:body"
           hx-target="this" hx-swap="innerHTML">
        <div class="loading">Loading…</div>
      </div>

      <div style="margin-top:14px;">
        <button class="btn ghost" @click="showRecent = !showRecent"
                x-text="showRecent ? 'Hide last 5 ›' : 'Show last 5 ›'">Show last 5 &rsaquo;</button>
      </div>
    </div>
  </section>

</main>

<script>
  document.addEventListener('alpine:init', function () {
    Alpine.data('dashboard', function () {
      return {
        updated: '—',
        revTotal: '—',
        charts: { trend: null, share: null, revenue: null },
        COLORS: { bkash: '#E2136E', nagad: '#F6921E', rocket: '#8A2BE2' },

        init: function () {
          var self = this;
          // Render whenever fresh stats arrive (initial auth + Refresh).
          window.addEventListener('stats-loaded', function (e) { self.render(e.detail); });
          if (this.$store.auth.stats) this.render(this.$store.auth.stats);
        },

        cards: function () {
          var s = this.$store.auth.stats;
          if (!s) return [];
          var t = s.totals, by = t.byPlatform || {};
          return [
            { label: 'All payments', cls: '',       count: t.count,                 amount: t.amount },
            { label: 'bKash',        cls: 'bkash',  count: (by.bkash || {}).count || 0,  amount: (by.bkash || {}).amount || 0 },
            { label: 'Nagad',        cls: 'nagad',  count: (by.nagad || {}).count || 0,  amount: (by.nagad || {}).amount || 0 },
            { label: 'Rocket',       cls: 'rocket', count: (by.rocket || {}).count || 0, amount: (by.rocket || {}).amount || 0 },
          ];
        },

        render: function (data) {
          this.updated = 'Updated ' + new Date().toLocaleTimeString();
          this.renderCharts(data);
        },

        renderCharts: function (data) {
          var self = this;
          if (typeof Chart === 'undefined') { setTimeout(function () { self.renderCharts(data); }, 150); return; }
          var d = data.daily, t = data.totals.byPlatform || {}, C = this.COLORS;
          var commonOpts = {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { labels: { color: '#94A2BE', font: { size: 11 }, usePointStyle: true, boxWidth: 7 } } },
          };

          var trendData = {
            labels: d.labels.map(function (s) { return s.slice(5); }),
            datasets: ['bkash', 'nagad', 'rocket'].map(function (p) {
              return { label: p, data: d.series[p] || [], backgroundColor: C[p], stack: 's', borderRadius: 3 };
            }),
          };
          if (this.charts.trend) { this.charts.trend.data = trendData; this.charts.trend.update(); }
          else {
            this.charts.trend = new Chart(this.$refs.trend, {
              type: 'bar', data: trendData,
              options: Object.assign({}, commonOpts, {
                scales: {
                  x: { stacked: true, grid: { display: false }, ticks: { color: '#5C6A86', font: { size: 10 } } },
                  y: { stacked: true, grid: { color: '#18233D' }, ticks: { color: '#5C6A86', precision: 0, font: { size: 10 } }, beginAtZero: true },
                },
              }),
            });
          }

          var shareData = {
            labels: ['bKash', 'Nagad', 'Rocket'],
            datasets: [{ data: [(t.bkash || {}).count || 0, (t.nagad || {}).count || 0, (t.rocket || {}).count || 0],
              backgroundColor: [C.bkash, C.nagad, C.rocket], borderColor: '#121A30', borderWidth: 2 }],
          };
          if (this.charts.share) { this.charts.share.data = shareData; this.charts.share.update(); }
          else {
            this.charts.share = new Chart(this.$refs.share, {
              type: 'doughnut', data: shareData,
              options: Object.assign({}, commonOpts, { cutout: '62%' }),
            });
          }

          var rev = data.revenue || { labels: d.labels, series: {}, total: [] };
          var taka = function (v) { return '৳ ' + Number(v).toLocaleString('en-US', { maximumFractionDigits: 0 }); };
          var revData = {
            labels: rev.labels.map(function (s) { return s.slice(5); }),
            datasets: ['bkash', 'nagad', 'rocket'].map(function (p) {
              return { label: p, data: rev.series[p] || [], backgroundColor: C[p], stack: 'r', borderRadius: 3 };
            }),
          };
          var revOpts = Object.assign({}, commonOpts, {
            plugins: Object.assign({}, commonOpts.plugins, {
              tooltip: { callbacks: { label: function (c) { return c.dataset.label + ': ' + taka(c.parsed.y); } } },
            }),
            scales: {
              x: { stacked: true, grid: { display: false }, ticks: { color: '#5C6A86', font: { size: 10 } } },
              y: { stacked: true, grid: { color: '#18233D' }, beginAtZero: true,
                   ticks: { color: '#5C6A86', font: { size: 10 }, callback: function (v) { return taka(v); } } },
            },
          });
          if (this.charts.revenue) { this.charts.revenue.data = revData; this.charts.revenue.options = revOpts; this.charts.revenue.update(); }
          else { this.charts.revenue = new Chart(this.$refs.revenue, { type: 'bar', data: revData, options: revOpts }); }

          var revSum = (rev.total || []).reduce(function (a, b) { return a + b; }, 0);
          this.revTotal = taka(revSum) + ' in 14 days';
        },
      };
    });
  });
</script>
<%- include('partials/scripts', { withChartJs: true }) %>

</body>
</html>
